
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>WeDo Market | Digital Marketplace</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');

:root{--bg:#080808;--panel:#111;--line:#252525;--white:#fff;--muted:#999}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--bg);color:white;font-family:Inter,Arial,sans-serif}
header{height:82px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 7%;position:sticky;top:0;background:#080808eF;backdrop-filter:blur(15px);z-index:10}
.logo{font-size:25px;font-weight:900;letter-spacing:-1.5px}
.logo span{color:#888}
nav{display:flex;gap:28px}
nav a{color:#aaa;text-decoration:none;font-size:13px;transition:.2s}
nav a:hover{color:white}
.cart{border:1px solid #444;background:white;color:black;padding:11px 18px;border-radius:7px;font-weight:800;cursor:pointer}
.hero{min-height:590px;display:flex;align-items:center;justify-content:center;text-align:center;padding:90px 20px;position:relative;overflow:hidden}
.hero:before{content:"";position:absolute;width:600px;height:600px;border-radius:50%;background:#fff;opacity:.055;filter:blur(120px);animation:glow 5s infinite alternate}
@keyframes glow{to{transform:scale(1.35);opacity:.1}}
.hero-content{position:relative;max-width:850px;animation:up .9s ease}
@keyframes up{from{opacity:0;transform:translateY(35px)}to{opacity:1;transform:translateY(0)}}
.tag{display:inline-block;border:1px solid #333;border-radius:30px;padding:9px 17px;color:#bbb;font-size:11px;letter-spacing:2px;margin-bottom:28px}
h1{font-size:clamp(48px,8vw,88px);line-height:.98;letter-spacing:-5px;font-weight:900}
h1 span{color:#777}
.hero p{color:#999;max-width:540px;margin:25px auto 32px;line-height:1.8;font-size:15px}
.primary{background:white;color:black;padding:15px 25px;border-radius:7px;text-decoration:none;font-weight:800;display:inline-block;transition:.25s}
.primary:hover{transform:translateY(-4px);box-shadow:0 10px 35px #ffffff22}
.section{padding:75px 7%}
.section-head{display:flex;align-items:end;justify-content:space-between;margin-bottom:35px;gap:20px}
.eyebrow{font-size:10px;letter-spacing:3px;color:#888;margin-bottom:12px}
h2{font-size:34px;letter-spacing:-1.5px}
.section-head p{color:#888;font-size:13px}
.categories{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}
.category{padding:25px;background:#101010;border:1px solid var(--line);border-radius:12px;transition:.3s;cursor:pointer}
.category:hover{background:#191919;transform:translateY(-5px);border-color:#555}
.category .symbol{font-size:25px;margin-bottom:20px}
.category h3{font-size:15px;margin-bottom:8px}
.category p{font-size:12px;color:#888}
.products{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.product{background:#101010;border:1px solid var(--line);border-radius:12px;overflow:hidden;transition:.3s}
.product:hover{transform:translateY(-6px);border-color:#555}
.product-art{height:175px;background:linear-gradient(140deg,#222,#090909);display:flex;align-items:center;justify-content:center;font-size:52px}
.product-info{padding:20px}
.product-type{font-size:10px;color:#888;letter-spacing:2px;text-transform:uppercase}
.product h3{font-size:16px;margin:10px 0}
.product p{font-size:12px;color:#888;line-height:1.6;min-height:38px}
.price-row{display:flex;align-items:center;justify-content:space-between;margin-top:20px}
.price{font-size:20px;font-weight:800}
.add{background:white;color:black;border:0;border-radius:6px;padding:10px 14px;font-weight:800;cursor:pointer}
.add:hover{background:#ccc}
.about{background:#101010;border-top:1px solid var(--line);border-bottom:1px solid var(--line);text-align:center;padding:75px 20px}
.about p{color:#999;max-width:580px;margin:17px auto;line-height:1.8;font-size:14px}
footer{padding:35px 7%;display:flex;justify-content:space-between;gap:20px;color:#777;font-size:12px}
.cart-panel{display:none;position:fixed;right:20px;top:95px;width:min(360px,calc(100% - 40px));background:#151515;border:1px solid #444;border-radius:12px;padding:22px;z-index:20;box-shadow:0 20px 70px #000}
.cart-panel.show{display:block}
.cart-panel h3{margin-bottom:18px}
.cart-item{display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid #333;font-size:13px}
.cart-total{display:flex;justify-content:space-between;margin:20px 0;font-weight:800}
.cart-panel button{cursor:pointer}
.close{float:right;background:none;border:0;color:white;font-size:20px}
.empty{color:#888;font-size:13px}
@media(max-width:750px){
 header{padding:0 5%}nav{display:none}
 .categories,.products{grid-template-columns:1fr}
 .section{padding:55px 5%}
 .section-head{display:block}.section-head p{margin-top:12px}
 h1{letter-spacing:-3px}
 footer{flex-direction:column}
}
</style>
</head>
<body>

<header>
 <div class="logo">WeDo<span>Market.</span></div>
 <nav>
  <a href="#home">Home</a><a href="#categories">Categories</a><a href="#products">Products</a><a href="#about">About</a>
 </nav>
 <button class="cart" onclick="toggleCart()">Cart (<span id="count">0</span>)</button>
</header>

<section class="hero" id="home">
 <div class="hero-content">
  <div class="tag">THE DIGITAL MARKETPLACE</div>
  <h1>YOUR DIGITAL<br><span>WORLD STARTS HERE.</span></h1>
  <p>Discover premium digital products, development services and solutions — all in one place.</p>
  <a href="#products" class="primary">Explore Products ↗</a>
 </div>
</section>

<section class="section" id="categories">
 <div class="section-head">
  <div><div class="eyebrow">EXPLORE</div><h2>Our Categories</h2></div>
  <p>Everything you need, in one marketplace.</p>
 </div>
 <div class="categories">
  <div class="category"><div class="symbol">⚡</div><h3>FiveM Ready Servers</h3><p>Ready-to-use server packages.</p></div>
  <div class="category"><div class="symbol">⚙️</div><h3>Discord Development</h3><p>Custom bots and Discord servers.</p></div>
  <div class="category"><div class="symbol">💎</div><h3>Digital Products</h3><p>Digital tools and resources.</p></div>
  <div class="category"><div class="symbol">🎨</div><h3>Graphics Packs</h3><p>Visual assets and designs.</p></div>
  <div class="category"><div class="symbol">🛠️</div><h3>Other Services</h3><p>Custom digital solutions.</p></div>
  <div class="category"><div class="symbol">🚀</div><h3>More Coming Soon</h3><p>New products are on the way.</p></div>
 </div>
</section>

<section class="section" id="products">
 <div class="section-head">
  <div><div class="eyebrow">OUR STORE</div><h2>Featured Products</h2></div>
  <p>Explore our latest digital products.</p>
 </div>
 <div class="products" id="product-list"></div>
</section>

<section class="about" id="about">
 <div class="eyebrow">WHO WE ARE</div>
 <h2>Built for the digital world.</h2>
 <p>WeDo Market brings digital products and development services together. Our goal is to make discovering quality digital solutions simple.</p>
 <a class="primary" href="mailto:contact@wedomarket.gr">Contact Us ↗</a>
</section>

<footer>
 <div class="logo">WeDo<span>Market.</span></div>
 <div>© 2026 WeDo Market. All rights reserved.</div>
 <div>Digital marketplace.</div>
</footer>

<div class="cart-panel" id="cart-panel">
 <button class="close" onclick="toggleCart()">×</button>
 <h3>Your Cart</h3>
 <div id="cart-items"><p class="empty">Your cart is empty.</p></div>
 <div class="cart-total"><span>Total</span><span id="total">€0.00</span></div>
 <p class="empty">Checkout will be available after payment setup.</p>
</div>

<script>
const products=[
 {name:"FiveM Server Package",type:"FiveM Ready Servers",description:"A starter package for your FiveM community.",price:49,icon:"⚡"},
 {name:"Discord Bot Development",type:"Discord Development",description:"A custom Discord bot for your server.",price:25,icon:"🤖"},
 {name:"Discord Server Setup",type:"Discord Development",description:"A professionally structured Discord server.",price:15,icon:"⚙️"},
 {name:"Graphics Starter Pack",type:"Graphics Packs",description:"A collection of digital graphics assets.",price:9,icon:"🎨"},
 {name:"Digital Resource Pack",type:"Digital Products",description:"Useful resources for your digital projects.",price:12,icon:"💎"},
 {name:"Custom Development",type:"Other Services",description:"A custom solution made for your needs.",price:35,icon:"🛠️"}
];
let cart=[];
const list=document.getElementById("product-list");
products.forEach((p,i)=>{
 const card=document.createElement("article");
 card.className="product";
 card.innerHTML=`<div class="product-art">${p.icon}</div>
 <div class="product-info"><div class="product-type">${p.type}</div>
 <h3>${p.name}</h3><p>${p.description}</p>
 <div class="price-row"><span class="price">€${p.price.toFixed(2)}</span>
 <button class="add" onclick="addToCart(${i})">Add +</button></div></div>`;
 list.appendChild(card);
});
function addToCart(i){cart.push(products[i]);renderCart()}
function renderCart(){
 document.getElementById("count").textContent=cart.length;
 const items=document.getElementById("cart-items");
 if(!cart.length){items.innerHTML='<p class="empty">Your cart is empty.</p>'}
 else{items.innerHTML=cart.map((p,i)=>`<div class="cart-item"><span>${p.name}</span><span>€${p.price.toFixed(2)} <button onclick="removeItem(${i})" style="background:none;color:#aaa;border:0;margin-left:8px">×</button></span></div>`).join("")}
 document.getElementById("total").textContent="€"+cart.reduce((s,p)=>s+p.price,0).toFixed(2);
}
function removeItem(i){cart.splice(i,1);renderCart()}
function toggleCart(){document.getElementById("cart-panel").classList.toggle("show")}
</script>
</body>
</html>
